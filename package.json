    "verify:build": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "vite": "7.1.9",
    "@playwright/test": "1.56.1",
    "rollup": "4.64.12"
  },
  "description": "An offline-first coding adventure in a garden of small, meaningful programs.",
  "author": "Noah Weiss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noahweiss3/lantern-garden.git"
  }
}
